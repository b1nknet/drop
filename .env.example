# $ 또는 # 등이 포함되면 작은따옴표로 감싸세요.
APP_PASSWORD=changeme

# 호스트의 실제 파일 저장 폴더. compose.yaml의 volumes.source에서도 직접 지정 가능.
UPLOAD_DIR=./data
PORT=8080

# 파일 하나의 최대 크기(MiB)
MAX_UPLOAD_MB=1024
SESSION_HOURS=12

# HTTPS 리버스 프록시 뒤에서 서비스할 때 true로 변경
COOKIE_SECURE=false

# 저장 폴더 소유자와 맞추세요. Linux에서 id -u / id -g로 확인.
APP_UID=1000
APP_GID=1000
